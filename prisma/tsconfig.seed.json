{
  // ts-node needs CommonJS to run the seed directly, but the app builds with
  // "nodenext". Passing --compiler-options inline breaks on Windows, where the
  // shell strips the quotes out of the JSON before ts-node sees it, so the
  // override lives in a file instead.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    // Inherited as true from the app config, where moduleResolution is
    // "nodenext". TypeScript rejects the pair outright (TS5098), and a
    // tsconfig that will not load takes the editor's language service with
    // it: every @prisma/client import in seed.ts underlines as unresolved,
    // which looks like a fault in the seed rather than in this file.
    "resolvePackageJsonExports": false,
    "noEmit": true,
    "incremental": false,
    "isolatedModules": false
  },
  "include": ["seed.ts"]
}
