// FixItPH — local services marketplace for Northern Mindanao and Caraga.
//
// Conventions used throughout this schema:
//   * Primary keys are UUIDs generated by Postgres (gen_random_uuid()), not by
//     the application, so rows created by raw SQL or seeds behave identically.
//   * snake_case column and table names via @map / @@map, because the raw SQL
//     migration (RLS policies, CHECK constraints, views, triggers) is written
//     against the physical names.
//   * Money is Decimal(12,2). Never Float.
//   * deleted_at marks soft deletion on users, services, bookings and reviews.
//     Those four are never hard-deleted. Application code filters on it and a
//     database trigger blocks DELETE.
//
// Anything that cannot be expressed in Prisma schema language (row level
// security, CHECK constraints, partial unique indexes, append-only triggers,
// the booking_contact_for_provider view) lives in
// prisma/migrations/<ts>_security/migration.sql and is applied by the same
// `prisma migrate` run.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED

  @@map("user_status")
}

/// Shared by providers (overall standing) and provider_documents (per file).
enum VerificationStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
  EXPIRED

  @@map("verification_status")
}

enum DocumentType {
  GOVERNMENT_ID
  BUSINESS_PERMIT
  BARANGAY_CLEARANCE
  PRC_LICENSE
  TESDA_CERTIFICATE
  PROOF_OF_ADDRESS
  OTHER

  @@map("document_type")
}

/// Whether a provider trades as a person or as a registered business. Decides
/// which documents verification asks for, and how the profile reads.
enum ProviderType {
  INDIVIDUAL
  BUSINESS

  @@map("provider_type")
}

enum PricingType {
  FIXED
  HOURLY
  PER_UNIT
  QUOTE_REQUIRED

  @@map("pricing_type")
}

enum ServiceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("service_status")
}

/// Lifecycle: DRAFT -> OPEN -> QUOTED -> ACCEPTED -> BOOKED -> CLOSED,
/// with CANCELLED and EXPIRED as terminal exits from any pre-BOOKED state.
enum RequestStatus {
  DRAFT
  OPEN
  QUOTED
  ACCEPTED
  BOOKED
  CANCELLED
  EXPIRED
  CLOSED

  @@map("request_status")
}

enum RequestUrgency {
  FLEXIBLE
  WITHIN_WEEK
  WITHIN_48H
  EMERGENCY

  @@map("request_urgency")
}

/// Lifecycle: PENDING -> ACCEPTED | REJECTED | WITHDRAWN | EXPIRED.
enum QuoteStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED

  @@map("quote_status")
}

/// Lifecycle: PENDING_CONFIRMATION -> CONFIRMED -> IN_PROGRESS -> COMPLETED,
/// with cancellation, no-show and dispute as terminal or escalating exits.
enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_PROVIDER
  NO_SHOW_CUSTOMER
  NO_SHOW_PROVIDER
  DISPUTED

  @@map("booking_status")
}

enum PaymentMethod {
  CASH
  GCASH
  MAYA
  BANK_TRANSFER

  @@map("payment_method")
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED

  @@map("payment_status")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("day_of_week")
}

enum ServiceAreaType {
  CITY
  BARANGAY
  RADIUS

  @@map("service_area_type")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM

  @@map("message_type")
}

enum NotificationType {
  REQUEST_RECEIVED
  QUOTE_RECEIVED
  QUOTE_ACCEPTED
  QUOTE_REJECTED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  BOOKING_REMINDER
  MESSAGE_RECEIVED
  REVIEW_RECEIVED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  DISPUTE_UPDATE
  SYSTEM

  @@map("notification_type")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH

  @@map("notification_channel")
}

enum ReportTargetType {
  USER
  PROVIDER
  SERVICE
  REVIEW
  MESSAGE
  BOOKING

  @@map("report_target_type")
}

enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE_CONTENT
  HARASSMENT
  NO_SHOW
  POOR_WORKMANSHIP
  FAKE_REVIEW
  OFF_PLATFORM_PAYMENT
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED

  @@map("report_status")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_CUSTOMER
  AWAITING_PROVIDER
  RESOLVED_REFUND
  RESOLVED_PARTIAL_REFUND
  RESOLVED_NO_ACTION
  ESCALATED
  CLOSED

  @@map("dispute_status")
}

/// How a platform setting's value is to be read out of its JSON column.
enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON

  @@map("setting_value_type")
}

enum AdminActionType {
  PROVIDER_VERIFICATION_APPROVE
  PROVIDER_VERIFICATION_REJECT
  DOCUMENT_APPROVE
  DOCUMENT_REJECT
  USER_SUSPEND
  USER_REINSTATE
  SERVICE_TAKEDOWN
  REVIEW_TAKEDOWN
  BOOKING_STATUS_OVERRIDE
  DISPUTE_RESOLVE
  REPORT_RESOLVE
  CATEGORY_MUTATE
  SETTING_UPDATE

  @@map("admin_action_type")
}

enum AdminActionTargetType {
  USER
  PROVIDER
  PROVIDER_DOCUMENT
  SERVICE
  BOOKING
  REVIEW
  REPORT
  DISPUTE
  CATEGORY
  SETTING

  @@map("admin_action_target_type")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Credentials and account state only. Personally identifying information
/// lives in `profiles`, which is a separate table so that queries serving
/// provider-facing screens can join the minimum they are entitled to.
model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique @db.Citext
  phone             String?    @unique @db.VarChar(20)
  /// Null for an account that only signs in through Google. Login treats
  /// that as "no password set" rather than as a password that never matches.
  passwordHash      String?    @map("password_hash") @db.Text
  role              UserRole   @default(CUSTOMER)
  status            UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  /// Reset to 0 on a successful login. Drives lockout together with lockedUntil.
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(6)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  profile             Profile?
  provider            Provider?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  emailVerifications  EmailVerificationToken[]
  oauthAccounts       OAuthAccount[]
  serviceRequests     ServiceRequest[]       @relation("CustomerServiceRequests")
  bookings            Booking[]              @relation("CustomerBookings")
  bookingsCancelled   Booking[]              @relation("BookingCancelledBy")
  statusChanges       BookingStatusHistory[]
  reviewsAuthored     Review[]               @relation("ReviewAuthor")
  messagesSent        Message[]              @relation("MessageSender")
  messagesReceived    Message[]              @relation("MessageRecipient")
  favorites           Favorite[]
  notifications       Notification[]
  reportsFiled        Report[]               @relation("ReportReporter")
  reportsResolved     Report[]               @relation("ReportResolver")
  disputesRaised      Dispute[]              @relation("DisputeRaisedBy")
  disputesResolved    Dispute[]              @relation("DisputeResolver")
  documentsReviewed   ProviderDocument[]     @relation("DocumentReviewer")
  adminActions        AdminAction[]
  settingsUpdated     PlatformSetting[]

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

/// One row per user. Holds the PII: legal name, exact address, coordinates.
model Profile {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(100)
  displayName  String?  @map("display_name") @db.VarChar(120)
  /// Private object storage key. Never returned raw; exchanged for a signed URL.
  avatarKey    String?  @map("avatar_key") @db.Text
  bio          String?  @db.Text
  addressLine1 String?  @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  barangay     String?  @db.VarChar(120)
  city         String?  @db.VarChar(120)
  province     String?  @db.VarChar(120)
  postalCode   String?  @map("postal_code") @db.VarChar(16)
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)
  locale       String   @default("en-PH") @db.VarChar(10)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city, barangay])
  @@map("profiles")
}

/// Rotating refresh tokens. Only the hash is stored. `familyId` groups a
/// rotation chain so that replaying a used token can revoke the whole family.
/// Which external identity provider an OAuthAccount belongs to. An enum
/// rather than free text so a typo cannot quietly create a second namespace
/// of account ids that nothing matches.
enum OAuthProvider {
  GOOGLE
}

/// A link between a FixItPH account and an identity somewhere else.
///
/// Its own table rather than a google_id column on users: the unique key that
/// matters is (provider, provider_account_id), a second provider is then a new
/// row rather than a new column, and unlinking is a delete.
model OAuthAccount {
  id       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String        @map("user_id") @db.Uuid
  provider OAuthProvider
  /// Google's stable subject id. Not the email: an email can be reassigned by
  /// a Workspace administrator, the subject id cannot.
  providerAccountId String @map("provider_account_id") @db.VarChar(255)
  /// The address Google asserted at link time, kept for support questions.
  email       String    @db.Citext
  linkedAt    DateTime  @default(now()) @map("linked_at") @db.Timestamptz(6)
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Text
  familyId   String    @map("family_id") @db.Uuid
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// A password reset happens in two steps, so the one-time code and the thing
/// that actually authorises the password change are never the same value.
///
///   1. forgot-password  emails a 6 digit code and stores only its hash
///   2. verify-reset-otp checks the code and issues `tokenHash`
///   3. reset-password   spends that token
///
/// A 6 digit code is only 20 bits, so it is protected by a short expiry, a
/// hard attempt limit, and a lockout rather than by its own entropy.
/// A short code emailed to confirm an address belongs to the person using it.
///
/// Same shape as PasswordResetToken and for the same reasons: the code is
/// stored only as an argon2id hash, wrong guesses are counted, and too many
/// locks the request rather than the account. Deliberately a separate table —
/// a reset token can change a password, and nothing that only proves "this
/// inbox is reachable" should ever be spendable for that.
model EmailVerificationToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// The address being proved. Kept so a code issued for a previous address
  /// cannot confirm a new one after a change of email.
  email        String    @db.Citext
  /// argon2id hash of the emailed code. The code itself is never stored.
  codeHash     String    @map("code_hash") @db.Text
  /// Wrong codes entered against this request.
  attemptCount Int       @default(0) @map("attempt_count")
  /// Set once attemptCount hits the limit. Blocks further guesses.
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp  String?   @map("requested_ip") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// argon2id hash of the emailed code. The code itself is never stored.
  codeHash     String    @map("code_hash") @db.Text
  /// Null until the code is verified. Issued once, spent once.
  tokenHash    String?   @unique @map("token_hash") @db.Text
  /// Wrong codes entered against this request.
  attemptCount Int       @default(0) @map("attempt_count")
  /// Set once attemptCount hits the limit. Blocks further guesses.
  lockedUntil  DateTime? @map("locked_until") @db.Timestamptz(6)
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(6)
  requestedIp  String?   @map("requested_ip") @db.Inet
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Providers
// ---------------------------------------------------------------------------

/// 1-to-1 extension of a user with role PROVIDER. `userId` is unique, so a
/// user can never hold two provider identities.
model Provider {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String             @unique @map("user_id") @db.Uuid
  providerType        ProviderType       @default(INDIVIDUAL) @map("provider_type")
  businessName        String             @map("business_name") @db.VarChar(160)
  slug                String             @unique @db.VarChar(160)
  headline            String?            @db.VarChar(200)
  bio                 String?            @db.Text
  /// Private bucket keys, served as short-lived signed URLs like every other
  /// upload. Null means the profile falls back to initials and a flat header.
  avatarKey           String?            @map("avatar_key") @db.Text
  coverKey            String?            @map("cover_key") @db.Text
  yearsExperience     Int?               @map("years_experience")
  verificationStatus  VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt          DateTime?          @map("verified_at") @db.Timestamptz(6)
  baseCity            String             @map("base_city") @db.VarChar(120)
  baseBarangay        String?            @map("base_barangay") @db.VarChar(120)
  latitude            Decimal?           @db.Decimal(9, 6)
  longitude           Decimal?           @db.Decimal(9, 6)
  serviceRadiusKm     Int?               @map("service_radius_km")
  /// Denormalised aggregates, recomputed inside the review transaction.
  ratingAvg           Decimal            @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount         Int                @default(0) @map("rating_count")
  completedJobsCount  Int                @default(0) @map("completed_jobs_count")
  responseTimeMinutes Int?               @map("response_time_minutes")
  acceptsEmergency    Boolean            @default(false) @map("accepts_emergency")
  isAcceptingBookings Boolean            @default(true) @map("is_accepting_bookings")
  paymentMethods      PaymentMethod[]    @map("payment_methods")
  suspendedAt         DateTime?          @map("suspended_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?          @map("deleted_at") @db.Timestamptz(6)

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       ProviderDocument[]
  services        Service[]
  serviceAreas    ServiceArea[]
  availability    Availability[]
  portfolioItems  PortfolioItem[]
  serviceRequests ServiceRequest[]
  quotes          Quote[]
  bookings        Booking[]
  reviews         Review[]
  favoritedBy     Favorite[]

  @@index([verificationStatus, isAcceptingBookings])
  @@index([baseCity, baseBarangay])
  @@index([ratingAvg(sort: Desc)])
  @@index([deletedAt])
  @@map("providers")
}

model ProviderDocument {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId       String             @map("provider_id") @db.Uuid
  documentType     DocumentType       @map("document_type")
  /// Private bucket key. Only ever exposed through a short-lived signed URL.
  storageKey       String             @map("storage_key") @db.Text
  originalFilename String             @map("original_filename") @db.VarChar(255)
  mimeType         String             @map("mime_type") @db.VarChar(120)
  sizeBytes        Int                @map("size_bytes")
  checksumSha256   String             @map("checksum_sha256") @db.Char(64)
  status           VerificationStatus @default(PENDING)
  reviewedById     String?            @map("reviewed_by") @db.Uuid
  reviewedAt       DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason  String?            @map("rejection_reason") @db.Text
  expiresAt        DateTime?          @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([providerId, status])
  @@index([status])
  @@map("provider_documents")
}

/// Cities and barangays a provider will travel to. Independent of any single
/// service, because coverage is a property of the person, not the listing.
model ServiceArea {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String          @map("provider_id") @db.Uuid
  areaType   ServiceAreaType @default(CITY) @map("area_type")
  city       String          @db.VarChar(120)
  barangay   String?         @db.VarChar(120)
  province   String?         @db.VarChar(120)
  radiusKm   Int?            @map("radius_km")
  surcharge  Decimal?        @db.Decimal(12, 2)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, city, barangay], map: "service_areas_provider_city_barangay_key")
  @@index([city, barangay])
  @@map("service_areas")
}

model Availability {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId String    @map("provider_id") @db.Uuid
  dayOfWeek  DayOfWeek @map("day_of_week")
  startTime  DateTime  @map("start_time") @db.Time(0)
  endTime    DateTime  @map("end_time") @db.Time(0)
  isClosed   Boolean   @default(false) @map("is_closed")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, dayOfWeek, startTime], map: "availability_provider_day_start_key")
  @@index([providerId])
  @@map("availability")
}

model PortfolioItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId  String    @map("provider_id") @db.Uuid
  title       String    @db.VarChar(160)
  description String?   @db.Text
  storageKey  String    @map("storage_key") @db.Text
  mimeType    String    @map("mime_type") @db.VarChar(120)
  completedAt DateTime? @map("completed_at") @db.Date
  position    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, position])
  @@map("portfolio_items")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Self-referencing tree. Depth is not enforced by the database; the service
/// layer keeps it to two levels (category -> subcategory).
model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(120)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  icon        String?  @db.VarChar(60)
  position    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children        Category[]       @relation("CategoryTree")
  services        Service[]
  serviceRequests ServiceRequest[]

  @@index([parentId, position])
  @@index([isActive])
  @@map("categories")
}

model Service {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId      String        @map("provider_id") @db.Uuid
  categoryId      String        @map("category_id") @db.Uuid
  title           String        @db.VarChar(160)
  slug            String        @db.VarChar(160)
  description     String        @db.Text
  pricingType     PricingType   @map("pricing_type")
  /// Required unless pricingType is QUOTE_REQUIRED. Enforced by a CHECK.
  price           Decimal?      @db.Decimal(12, 2)
  priceUnit       String?       @map("price_unit") @db.VarChar(40)
  minPrice        Decimal?      @map("min_price") @db.Decimal(12, 2)
  maxPrice        Decimal?      @map("max_price") @db.Decimal(12, 2)
  currency        String        @default("PHP") @db.Char(3)
  durationMinutes Int?          @map("duration_minutes")
  status          ServiceStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz(6)

  provider        Provider         @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images          ServiceImage[]
  serviceRequests ServiceRequest[]
  bookings        Booking[]

  @@unique([providerId, slug], map: "services_provider_id_slug_key")
  @@index([categoryId, status])
  @@index([providerId, status])
  @@index([deletedAt])
  @@map("services")
}

model ServiceImage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  storageKey String   @map("storage_key") @db.Text
  mimeType   String   @map("mime_type") @db.VarChar(120)
  altText    String?  @map("alt_text") @db.VarChar(255)
  position   Int      @default(0)
  width      Int?
  height     Int?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId, position])
  @@map("service_images")
}

// ---------------------------------------------------------------------------
// Request -> quote -> booking
// ---------------------------------------------------------------------------

/// A customer's job post. `providerId` null means it was broadcast to the
/// area; non-null means it was sent to one provider directly.
///
/// addressLine1 / latitude / longitude are the exact location. They are only
/// released to a provider through booking_contact_for_provider, and only once
/// the resulting booking is CONFIRMED.
model ServiceRequest {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String         @map("customer_id") @db.Uuid
  providerId   String?        @map("provider_id") @db.Uuid
  serviceId    String?        @map("service_id") @db.Uuid
  categoryId   String         @map("category_id") @db.Uuid
  title        String         @db.VarChar(200)
  description  String         @db.Text
  urgency      RequestUrgency @default(FLEXIBLE)
  preferredAt  DateTime?      @map("preferred_at") @db.Timestamptz(6)
  budgetMin    Decimal?       @map("budget_min") @db.Decimal(12, 2)
  budgetMax    Decimal?       @map("budget_max") @db.Decimal(12, 2)
  city         String         @db.VarChar(120)
  barangay     String?        @db.VarChar(120)
  addressLine1 String?        @map("address_line1") @db.VarChar(255)
  latitude     Decimal?       @db.Decimal(9, 6)
  longitude    Decimal?       @db.Decimal(9, 6)
  status       RequestStatus  @default(OPEN)
  expiresAt    DateTime?      @map("expires_at") @db.Timestamptz(6)
  closedAt     DateTime?      @map("closed_at") @db.Timestamptz(6)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer User      @relation("CustomerServiceRequests", fields: [customerId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  service  Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  quotes   Quote[]
  bookings Booking[]
  messages Message[]

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([status, city, createdAt(sort: Desc)])
  @@index([categoryId, status])
  @@map("service_requests")
}

/// A provider's priced answer to a request. A partial unique index in the
/// security migration keeps at most one live (PENDING or ACCEPTED) quote per
/// provider per request.
model Quote {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceRequestId         String      @map("service_request_id") @db.Uuid
  providerId               String      @map("provider_id") @db.Uuid
  amount                   Decimal     @db.Decimal(12, 2)
  currency                 String      @default("PHP") @db.Char(3)
  laborCost                Decimal?    @map("labor_cost") @db.Decimal(12, 2)
  partsCost                Decimal?    @map("parts_cost") @db.Decimal(12, 2)
  breakdown                Json?       @db.JsonB
  notes                    String?     @db.Text
  estimatedDurationMinutes Int?        @map("estimated_duration_minutes")
  validUntil               DateTime?   @map("valid_until") @db.Timestamptz(6)
  status                   QuoteStatus @default(PENDING)
  respondedAt              DateTime?   @map("responded_at") @db.Timestamptz(6)
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  booking        Booking?

  @@index([serviceRequestId, status])
  @@index([providerId, status])
  @@map("quotes")
}

/// Created only by accepting a quote, so `quoteId` is unique: one quote can
/// never produce two bookings.
model Booking {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId            String        @unique @map("quote_id") @db.Uuid
  serviceRequestId   String        @map("service_request_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  providerId         String        @map("provider_id") @db.Uuid
  serviceId          String?       @map("service_id") @db.Uuid
  scheduledStart     DateTime      @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd       DateTime?     @map("scheduled_end") @db.Timestamptz(6)
  actualStart        DateTime?     @map("actual_start") @db.Timestamptz(6)
  actualEnd          DateTime?     @map("actual_end") @db.Timestamptz(6)
  status             BookingStatus @default(PENDING_CONFIRMATION)
  totalAmount        Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency           String        @default("PHP") @db.Char(3)
  paymentMethod      PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus      PaymentStatus @default(UNPAID) @map("payment_status")
  /// Set when the booking is confirmed. Gates release of the exact address.
  contactReleasedAt  DateTime?     @map("contact_released_at") @db.Timestamptz(6)
  cancellationReason String?       @map("cancellation_reason") @db.Text
  cancelledById      String?       @map("cancelled_by") @db.Uuid
  cancelledAt        DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)

  quote          Quote                  @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  serviceRequest ServiceRequest         @relation(fields: [serviceRequestId], references: [id], onDelete: Restrict)
  customer       User                   @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  provider       Provider               @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service        Service?               @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  cancelledBy    User?                  @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  statusHistory  BookingStatusHistory[]
  review         Review?
  messages       Message[]
  disputes       Dispute[]

  @@index([customerId, status])
  @@index([providerId, status])
  @@index([scheduledStart])
  @@index([deletedAt])
  @@map("bookings")
}

/// Append-only. UPDATE and DELETE are revoked from the application role and
/// blocked by a trigger, so the audit trail cannot be rewritten.
model BookingStatusHistory {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  changedById String?        @map("changed_by") @db.Uuid
  reason      String?        @db.Text
  metadata    Json?          @db.JsonB
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ---------------------------------------------------------------------------
// Reviews and messaging
// ---------------------------------------------------------------------------

/// One review per booking, enforced by the unique constraint on bookingId.
/// Edits append to editHistory rather than overwriting the comment.
model Review {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId           String    @unique @map("booking_id") @db.Uuid
  authorId            String    @map("author_id") @db.Uuid
  providerId          String    @map("provider_id") @db.Uuid
  rating              Int
  punctualityRating   Int?      @map("punctuality_rating")
  qualityRating       Int?      @map("quality_rating")
  valueRating         Int?      @map("value_rating")
  comment             String?   @db.Text
  /// Append-only array of { comment, rating, editedAt } snapshots.
  editHistory         Json      @default("[]") @map("edit_history") @db.JsonB
  providerResponse    String?   @map("provider_response") @db.Text
  providerRespondedAt DateTime? @map("provider_responded_at") @db.Timestamptz(6)
  isHidden            Boolean   @default(false) @map("is_hidden")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, isHidden, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([deletedAt])
  @@map("reviews")
}

/// Anchored to exactly one of bookingId or serviceRequestId (CHECK enforced),
/// which is what lets the RLS policy decide visibility without a join table.
model Message {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String?     @map("booking_id") @db.Uuid
  serviceRequestId String?     @map("service_request_id") @db.Uuid
  senderId         String      @map("sender_id") @db.Uuid
  recipientId      String      @map("recipient_id") @db.Uuid
  messageType      MessageType @default(TEXT) @map("message_type")
  body             String      @db.Text
  readAt           DateTime?   @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  booking        Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceRequest ServiceRequest?     @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  sender         User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      User                @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  attachments    MessageAttachment[]

  @@index([bookingId, createdAt])
  @@index([serviceRequestId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

model MessageAttachment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId        String   @map("message_id") @db.Uuid
  storageKey       String   @map("storage_key") @db.Text
  originalFilename String   @map("original_filename") @db.VarChar(255)
  mimeType         String   @map("mime_type") @db.VarChar(120)
  sizeBytes        Int      @map("size_bytes")
  checksumSha256   String   @map("checksum_sha256") @db.Char(64)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

// ---------------------------------------------------------------------------
// Engagement, moderation, audit
// ---------------------------------------------------------------------------

model Favorite {
  customerId String   @map("customer_id") @db.Uuid
  providerId String   @map("provider_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([customerId, providerId])
  @@index([providerId])
  @@map("favorites")
}

model Notification {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      NotificationType
  channel   NotificationChannel @default(IN_APP)
  title     String              @db.VarChar(200)
  body      String              @db.Text
  data      Json?               @db.JsonB
  readAt    DateTime?           @map("read_at") @db.Timestamptz(6)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Polymorphic by (targetType, targetId). No FK, because the target can be any
/// of six tables; the service layer validates existence before insert.
model Report {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId      String           @map("reporter_id") @db.Uuid
  targetType      ReportTargetType @map("target_type")
  targetId        String           @map("target_id") @db.Uuid
  reason          ReportReason
  details         String?          @db.Text
  status          ReportStatus     @default(OPEN)
  resolvedById    String?          @map("resolved_by") @db.Uuid
  resolvedAt      DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolutionNotes String?          @map("resolution_notes") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId], map: "reports_reporter_target_key")
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model Dispute {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String        @map("booking_id") @db.Uuid
  raisedById   String        @map("raised_by") @db.Uuid
  reason       String        @db.VarChar(200)
  details      String        @db.Text
  status       DisputeStatus @default(OPEN)
  resolution   String?       @db.Text
  refundAmount Decimal?      @map("refund_amount") @db.Decimal(12, 2)
  resolvedById String?       @map("resolved_by") @db.Uuid
  resolvedAt   DateTime?     @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  raisedBy   User    @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  resolvedBy User?   @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("disputes")
}

/// Operator-editable platform configuration. Key/value rather than a column
/// per setting, so adding one is a seed row instead of a migration. Every
/// write goes through the admin module and lands in admin_actions.
///
/// isPublic marks the rows the unauthenticated site may read (a maintenance
/// notice has to be readable by someone who cannot log in). RLS enforces that
/// split, so a mistake in the service layer cannot expose a private setting.
model PlatformSetting {
  key         String           @id @db.VarChar(80)
  value       Json             @db.JsonB
  valueType   SettingValueType @default(STRING) @map("value_type")
  label       String           @db.VarChar(160)
  description String?          @db.Text
  group       String           @default("general") @db.VarChar(60)
  position    Int              @default(0)
  /// Readable without authentication. Keep false unless the public site needs it.
  isPublic    Boolean          @default(false) @map("is_public")
  /// Set by an operator rather than seeded. Editing is refused for false.
  isEditable  Boolean          @default(true) @map("is_editable")
  updatedById String?          @map("updated_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group, position])
  @@index([isPublic])
  @@map("platform_settings")
}

/// Insert-only audit log. Written in the same transaction as the action it
/// records, so an admin change and its audit row commit or fail together.
model AdminAction {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String                @map("admin_id") @db.Uuid
  actionType AdminActionType       @map("action_type")
  targetType AdminActionTargetType @map("target_type")
  targetId   String                @map("target_id") @db.Uuid
  reason     String?               @db.Text
  before     Json?                 @db.JsonB
  after      Json?                 @db.JsonB
  ipAddress  String?               @map("ip_address") @db.Inet
  userAgent  String?               @map("user_agent") @db.Text
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  admin User @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("admin_actions")
}
