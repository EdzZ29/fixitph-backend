# ---------------------------------------------------------------------------
# FixItPH API environment
#
# Copy to .env and fill in. .env is gitignored; this file is the checked-in
# reference and must never hold a real secret.
#
#   cp .env.example .env
#
# Generate the two JWT secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

NODE_ENV=development

# The API listens here.
#
# 4000, not 3000, because this machine's PostgreSQL is configured on 3000 and
# two processes cannot share a port. If you later move Postgres to 5432 you can
# move this back to 3000, but then you must also update NEXT_PUBLIC_API_URL in
# the frontend and the port in this file's DATABASE_ URLs.
PORT=4000
API_PREFIX=api

# --- Database --------------------------------------------------------------
# Two URLs, deliberately.
#
# DATABASE_URL is the owner. Prisma Migrate uses it, and only it.
#
# DATABASE_APP_URL is what the running API connects as. It must be a non-owner,
# NOBYPASSRLS role, because a table owner skips every row level security policy
# silently. The API checks this at boot and refuses to start if the role can
# bypass RLS or owns a protected table.
#
# Port 3000 matches the locally installed PostgreSQL 17 on this machine. Create
# the runtime role once with:
#   psql -h localhost -p 3000 -U postgres -d fixitph -f scripts/setup-local-postgres.sql
DATABASE_URL=postgresql://postgres:admin@localhost:3000/fixitph?schema=public
DATABASE_APP_URL=postgresql://fixitph_app:fixitph_app_dev_password@localhost:3000/fixitph?schema=public

# Consumed by docker-compose only. Ignored when you use a local Postgres
# install, which is the setup on this machine.
POSTGRES_USER=fixitph
POSTGRES_PASSWORD=fixitph_dev_password
POSTGRES_DB=fixitph
POSTGRES_PORT=5432
APP_DB_USER=fixitph_app
APP_DB_PASSWORD=fixitph_app_dev_password

# --- Redis -----------------------------------------------------------------
# Leave empty to use an in-memory cache. That works for a single developer on a
# machine with no Docker and no Redis, but it is per process: two API instances
# would hold different caches and an invalidation on one would not reach the
# other. Set a redis:// URL for anything beyond local development.
REDIS_URL=
REDIS_PORT=6379

# --- Auth ------------------------------------------------------------------
# Both must be at least 32 characters, and must differ from each other.
JWT_ACCESS_SECRET=replace-me-with-48-random-bytes-base64url-encoded
JWT_REFRESH_SECRET=replace-me-with-a-different-48-random-bytes-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=fixitph

# Account lockout after this many consecutive failures.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Cookies ---------------------------------------------------------------
# The refresh token lives in an httpOnly cookie. Set COOKIE_SECURE=true for any
# deployment reachable over HTTPS.
COOKIE_SECURE=false
# COOKIE_DOMAIN=.fixitph.com

# --- CORS ------------------------------------------------------------------
# Strict allow-list, comma separated. Never a wildcard: credentials are enabled,
# and a wildcard with credentials is the same as no protection at all.
CORS_ORIGIN=http://localhost:3001

# --- Mail ------------------------------------------------------------------
# Leave SMTP_HOST empty and password reset codes are written to the API log
# instead of emailed. That is fine locally. In production the API refuses to
# start without it, because a silently dropped reset code is a lockout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=FixItPH <no-reply@fixitph.example>

# --- Password reset --------------------------------------------------------
# A six digit code is short by design, so these three numbers are what make it
# safe: a short life, a hard attempt limit, and a lockout.
RESET_CODE_TTL_MINUTES=10
RESET_MAX_ATTEMPTS=3
RESET_LOCKOUT_MINUTES=15

# --- Rate limits -----------------------------------------------------------
# Optional overrides for src/common/throttle.ts. Raising these is for running
# end-to-end tests without waiting out a window, not for production.
# THROTTLE_LOGIN=10
# THROTTLE_FORGOT_PASSWORD=3
# THROTTLE_VERIFY_CODE=10

# --- Object storage (S3 compatible) ---------------------------------------
# Defaults match the MinIO service in docker-compose.yml. The bucket is private;
# files are only ever served through short-lived signed URLs. Uploads are the
# one feature that needs this, so it can stay unset until you get to them.
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=fixitph-private
S3_ACCESS_KEY_ID=fixitph_minio
S3_SECRET_ACCESS_KEY=fixitph_minio_dev_password
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=10485760
